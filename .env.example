# ---------------------------------------------------------------------------
# Discord
# Each name below matches the label Discord itself uses, so you can copy
# values across without translating.
# ---------------------------------------------------------------------------

# Developer portal -> your application -> Bot -> "Reset Token"
# Treat this like a password; anyone with it controls the bot.
DISCORD_BOT_TOKEN=

# Developer portal -> your application -> General Information -> "Application ID"
DISCORD_APPLICATION_ID=

# Right-click your server icon -> "Copy Server ID"
# (needs Settings -> Advanced -> Developer Mode turned on)
#
# Heads-up: Discord's UI says "Server" but its API says "Guild" - they mean the
# same thing. That is why the code refers to guildId while this variable does not.
DISCORD_SERVER_ID=

# Right-click #meeting-summary -> "Copy Channel ID"
SUMMARY_CHANNEL_ID=

# ---------------------------------------------------------------------------
# AI providers (not required until milestones 2 and 3)
# ---------------------------------------------------------------------------

# console.groq.com -> API Keys. Used for Whisper transcription.
GROQ_API_KEY=

# aistudio.google.com -> Get API key. Used for meeting summarisation.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# IANA timezone for summary timestamps, e.g. America/New_York
TZ=UTC

# debug | info | warn | error
LOG_LEVEL=info

# How long to keep trying to recover a dropped voice connection before giving
# up and ending the recording. Raise it if your network is flaky; the cost of a
# high value is that the bot sits in the channel doing nothing while it waits.
VOICE_RECONNECT_GRACE_SECONDS=120

# Development only. Keeps recorded audio instead of deleting it after
# transcription, so you can re-run the pipeline without re-recording.
KEEP_AUDIO=false
