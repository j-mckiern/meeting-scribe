# ---------------------------------------------------------------------------
# Discord
# Each name below matches the label Discord itself uses, so you can copy
# values across without translating.
# ---------------------------------------------------------------------------

# Developer portal -> your application -> Bot -> "Reset Token"
# Treat this like a password; anyone with it controls the bot.
DISCORD_BOT_TOKEN=

# Developer portal -> your application -> General Information -> "Application ID"
DISCORD_APPLICATION_ID=

# Right-click your server icon -> "Copy Server ID"
# (needs Settings -> Advanced -> Developer Mode turned on)
#
# Heads-up: Discord's UI says "Server" but its API says "Guild" - they mean the
# same thing. That is why the code refers to guildId while this variable does not.
DISCORD_SERVER_ID=

# Right-click #meeting-summary -> "Copy Channel ID"
SUMMARY_CHANNEL_ID=

# ---------------------------------------------------------------------------
# AI providers (not required until milestones 2 and 3)
# ---------------------------------------------------------------------------

# Where transcription runs. `local` keeps the audio on this machine; `groq`
# uploads it. Local is the default deliberately - the recordings are of people
# who agreed to be in a meeting, not to be sent to an inference vendor.
# Groq is kept as a quality baseline to compare local output against.
TRANSCRIBER=local

# Interpreter with faster-whisper installed:
#   uv venv .venv-whisper && uv pip install --python .venv-whisper faster-whisper
WHISPER_PYTHON=./.venv-whisper/bin/python

# Any CTranslate2 Whisper model. `turbo` is ~8x faster than large-v3 at close
# to the same quality, which is what makes CPU-only viable.
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2

# auto | cpu | cuda. Left on auto so the same .env works on a laptop and on a
# machine with a GPU.
WHISPER_DEVICE=auto

# auto, or pin it: int8 on CPU, float16 on a GPU.
WHISPER_COMPUTE_TYPE=auto

# Only needed when TRANSCRIBER=groq.
# console.groq.com -> API Keys.
GROQ_API_KEY=

# aistudio.google.com -> Get API key. Used for meeting summarisation.
GEMINI_API_KEY=

# Whisper model on Groq. The `-turbo` variant is the fast, free-tier one.
GROQ_MODEL=whisper-large-v3-turbo

# ISO-639-1 language code for transcription, or `auto` to detect per segment.
# Pinning it is the default: detection runs on one segment at a time, and a few
# seconds of a noisy microphone is enough for the model to "detect" another
# language and translate the rest of the burst into it.
TRANSCRIPTION_LANGUAGE=en

# Names, products and jargon Whisper would otherwise mangle - proper nouns, not
# sentences. Passed to the model as context preceding each segment, so anything
# written here is something the model may repeat when it cannot hear anything.
# e.g. TRANSCRIPTION_VOCABULARY=Kubernetes, Grafana, Postgres, Aoife, Sean
TRANSCRIPTION_VOCABULARY=

# Transcription requests in flight at once. The Groq free tier is rate limited
# per minute, so raising this mostly buys rate-limit retries.
TRANSCRIBE_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# IANA timezone for summary timestamps, e.g. America/New_York
TZ=UTC

# debug | info | warn | error
LOG_LEVEL=info

# How long to keep trying to recover a dropped voice connection before giving
# up and ending the recording. Raise it if your network is flaky; the cost of a
# high value is that the bot sits in the channel doing nothing while it waits.
VOICE_RECONNECT_GRACE_SECONDS=120

# Development only. Keeps recorded audio instead of deleting it after
# transcription, so you can re-run the pipeline without re-recording.
KEEP_AUDIO=false
